{
  "name": "take-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Take - Open-source multi-agent group chat client for AI creators and users",
  "author": "Take Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @take/desktop dev",
    "dev:web": "pnpm --filter @take/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "license-check": "license-checker --production --onlyAllow \"MIT;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}

