{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TakeChat",
  "version": "0.1.0",
  "identifier": "im.take.client",
  "build": {
    "beforeDevCommand": "pnpm --filter @take/desktop build:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @take/desktop build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TakeChat",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.deepseek.com https://api.moonshot.cn https://openrouter.ai http://127.0.0.1:* http://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

